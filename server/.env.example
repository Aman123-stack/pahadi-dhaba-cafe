# Port the API (and, in production, the built React site) listens on
PORT=5050

# Set a long random value to enable GET /api/reservations and GET /api/reviews/submissions
# (send it as the header  x-admin-token: <value>). Leave empty to keep them disabled.
ADMIN_TOKEN=

# Set to 1 when running behind a reverse proxy (Nginx, Render, Railway...) so rate limiting sees real client IPs
TRUST_PROXY=0

# Where reservations / review submissions are stored as JSON (default: server/storage)
# DATA_DIR=
